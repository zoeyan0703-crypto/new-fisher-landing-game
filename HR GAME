<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>创光计划 · 光之大陆探险 | 2026届海外委培</title>
<style>
:root {
  --cosmic: #0a0e27; --star: #6366f1; --light: #60a5fa;
  --green: #10b981; --amber: #f59e0b; --rose: #f43f5e;
  --surface: rgba(15, 23, 42, 0.92);
}
* { margin:0; padding:0; box-sizing:border-box; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #050816; color: #e2e8f0; overflow-x: hidden; min-height: 100vh;
}
/* ---- Starfield Canvas ---- */
#starfield { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:0; }

/* ---- Main Container ---- */
.game-container { position:relative; z-index:1; max-width:720px; margin:0 auto; padding:24px 16px 48px; min-height:100vh; display:flex; flex-direction:column; }

/* ---- Screens ---- */
.screen { display:none; flex-direction:column; align-items:center; flex:1; }
.screen.active { display:flex; }

/* ---- Intro Screen ---- */
.intro { justify-content:center; text-align:center; padding:40px 0; }
.intro-logo { width:100px; height:100px; border-radius:50%; background:radial-gradient(circle, #6366f1 0%, #0a0e27 70%); margin-bottom:24px; display:flex; align-items:center; justify-content:center; font-size:42px; box-shadow:0 0 60px rgba(99,102,241,0.4); }
.intro h1 { font-size:36px; font-weight:800; background:linear-gradient(135deg,#818cf8,#38bdf8,#34d399); -webkit-background-clip:text; -webkit-text-fill-color:transparent; margin-bottom:8px; }
.intro .sub { font-size:16px; color:#94a3b8; margin-bottom:32px; letter-spacing:2px; }
.intro .lore { background:var(--surface); border:1px solid #1e293b; border-radius:16px; padding:20px 24px; margin-bottom:32px; font-size:14px; color:#94a3b8; text-align:left; line-height:1.8; }
.intro .lore strong { color:#818cf8; }

.name-input-group { margin-bottom:32px; width:100%; max-width:360px; }
.name-input-group label { display:block; font-size:13px; color:#94a3b8; margin-bottom:8px; }
.name-input-group input, .name-input-group select {
  width:100%; padding:12px 16px; border-radius:10px; border:1px solid #334155;
  background:#0f172a; color:#e2e8f0; font-size:16px; outline:none; transition:border .2s;
}
.name-input-group input:focus, .name-input-group select:focus { border-color:#6366f1; }

.btn {
  display:inline-flex; align-items:center; gap:8px; padding:14px 36px;
  border-radius:50px; font-size:16px; font-weight:700; cursor:pointer;
  border:none; transition:all .3s; text-decoration:none; position:relative; overflow:hidden;
}
.btn-primary { background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; box-shadow:0 4px 20px rgba(99,102,241,0.4); }
.btn-primary:hover { box-shadow:0 6px 30px rgba(99,102,241,0.6); transform:translateY(-1px); }
.btn-secondary { background:rgba(255,255,255,0.08); color:#e2e8f0; border:1px solid #334155; }
.btn-secondary:hover { background:rgba(255,255,255,0.12); }

/* ---- Progress Bar ---- */
.progress-wrap { width:100%; margin-bottom:8px; }
.progress-info { display:flex; justify-content:space-between; font-size:12px; color:#64748b; margin-bottom:6px; }
.progress-bar { height:4px; background:#1e293b; border-radius:2px; overflow:hidden; }
.progress-fill { height:100%; background:linear-gradient(90deg,#6366f1,#8b5cf6,#38bdf8); border-radius:2px; transition:width .5s ease; }

/* ---- Level Scene ---- */
.level-header { text-align:center; margin-bottom:24px; }
.level-icon { font-size:48px; margin-bottom:8px; }
.level-name { font-size:24px; font-weight:800; color:#e2e8f0; margin-bottom:4px; }
.level-desc { font-size:13px; color:#64748b; }

/* ---- Question Card ---- */
.question-card {
  background:var(--surface); border:1px solid #1e293b; border-radius:16px;
  padding:28px 24px; margin-bottom:16px; width:100%;
  animation: fadeCard .4s ease;
}
@keyframes fadeCard { from{opacity:0;transform:translateY(12px);} to{opacity:1;transform:translateY(0);} }
.question-card .q-num { font-size:11px; color:#6366f1; text-transform:uppercase; letter-spacing:2px; margin-bottom:12px; }
.question-card .q-text { font-size:16px; line-height:1.7; margin-bottom:20px; color:#f1f5f9; }

/* Options */
.option-list { display:flex; flex-direction:column; gap:10px; }
.option {
  display:flex; align-items:flex-start; gap:12px; padding:14px 16px;
  border:1.5px solid #1e293b; border-radius:12px; cursor:pointer;
  transition:all .2s; background:rgba(255,255,255,0.02);
}
.option:hover { border-color:#475569; background:rgba(255,255,255,0.04); }
.option.selected { border-color:#6366f1; background:rgba(99,102,241,0.1); }
.option .radio { flex-shrink:0; width:20px; height:20px; border-radius:50%; border:2px solid #475569; transition:all .2s; display:flex; align-items:center; justify-content:center; }
.option.selected .radio { border-color:#6366f1; background:#6366f1; }
.option.selected .radio::after { content:''; width:6px; height:6px; border-radius:50%; background:#fff; }
.option .opt-text { font-size:14px; color:#cbd5e1; }
.option.selected .opt-text { color:#e2e8f0; }

/* Checkbox options */
.option.multi .radio { border-radius:4px; }
.option.multi.selected .radio { border-radius:4px; }
.option.multi.selected .radio::after { content:'✓'; color:#fff; font-size:12px; background:transparent; width:auto; height:auto; }

/* Textarea */
.text-input { width:100%; padding:14px 16px; border-radius:12px; border:1.5px solid #1e293b; background:#0f172a; color:#e2e8f0; font-size:14px; resize:vertical; min-height:100px; outline:none; font-family:inherit; transition:border .2s; }
.text-input:focus { border-color:#6366f1; }

/* Slider */
.slider-group { margin:8px 0; }
.slider-label { display:flex; justify-content:space-between; font-size:13px; color:#94a3b8; margin-bottom:6px; }
.slider-row { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
.slider-row input[type=range] { flex:1; -webkit-appearance:none; height:6px; border-radius:3px; background:#1e293b; outline:none; }
.slider-row input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:22px; height:22px; border-radius:50%; background:#6366f1; cursor:pointer; box-shadow:0 0 12px rgba(99,102,241,0.5); }
.slider-val { font-size:13px; color:#6366f1; font-weight:700; min-width:40px; text-align:right; }

/* Navigation */
.nav-row { display:flex; justify-content:space-between; align-items:center; width:100%; margin-top:8px; }
.timer-indicator { display:flex; align-items:center; gap:6px; font-size:12px; color:#64748b; }
.timer-dot { width:6px; height:6px; border-radius:50%; background:#10b981; animation:pulse 1.5s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

.chars-left { font-size:12px; color:#64748b; margin-top:4px; text-align:right; }

/* ---- Results Screen ---- */
.results { padding:20px 0; }
.results-header { text-align:center; margin-bottom:32px; }
.results-header .badge { display:inline-block; background:rgba(16,185,129,0.15); color:#34d399; padding:6px 18px; border-radius:20px; font-size:13px; margin-bottom:16px; }
.results-header h2 { font-size:28px; font-weight:800; margin-bottom:4px; }
.results-header .p-name { font-size:18px; color:#818cf8; margin-bottom:16px; }
.results-header .stats-row { display:flex; gap:24px; justify-content:center; flex-wrap:wrap; }
.stat-item { text-align:center; }
.stat-item .val { font-size:28px; font-weight:800; background:linear-gradient(135deg,#818cf8,#38bdf8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
.stat-item .label { font-size:11px; color:#64748b; margin-top:2px; }

.radar-box { width:100%; max-width:420px; margin:0 auto 24px; }
.dim-legend { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:24px; }
.dim-item { background:var(--surface); border:1px solid #1e293b; border-radius:10px; padding:12px 14px; }
.dim-item .dim-name { font-size:13px; font-weight:600; color:#e2e8f0; margin-bottom:2px; }
.dim-item .dim-bar-wrap { height:6px; background:#1e293b; border-radius:3px; margin-top:4px; overflow:hidden; }
.dim-item .dim-bar { height:100%; border-radius:3px; transition:width 1s ease; }
.dim-item .dim-score { font-size:12px; color:#94a3b8; margin-top:2px; }

.insight-card { background:var(--surface); border:1px solid #1e293b; border-radius:16px; padding:20px 24px; margin-bottom:16px; width:100%; }
.insight-card h4 { font-size:14px; color:#818cf8; margin-bottom:8px; }
.insight-card p { font-size:13px; color:#94a3b8; line-height:1.7; }

.export-hint { text-align:center; color:#475569; font-size:12px; margin-top:24px; padding:16px; border-top:1px solid #1e293b; }

/* Animations */
@keyframes twinkle { 0%,100%{opacity:0.3} 50%{opacity:1} }
.spark { animation:twinkle 2s infinite; }

/* Loading particles between levels */
.level-transition {
  position:fixed; top:0; left:0; width:100%; height:100%; z-index:10;
  background:rgba(5,8,22,0.95); display:none; align-items:center; justify-content:center; flex-direction:column; gap:16px;
}
.level-transition.show { display:flex; }
.level-transition .lt-icon { font-size:56px; }
.level-transition .lt-text { font-size:18px; font-weight:700; color:#e2e8f0; }
.level-transition .lt-sub { font-size:13px; color:#64748b; }

/* Confirm dialog */
.confirm-overlay { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:20; align-items:center; justify-content:center; }
.confirm-overlay.show { display:flex; }
.confirm-box { background:#0f172a; border:1px solid #1e293b; border-radius:16px; padding:32px; text-align:center; max-width:380px; }
.confirm-box h3 { font-size:18px; margin-bottom:12px; }
.confirm-box p { font-size:14px; color:#94a3b8; margin-bottom:24px; }
.confirm-box .btn-row { display:flex; gap:12px; justify-content:center; }

/* Pulse ring for selected */
.pulse-ring { position:absolute; top:-4px; left:-4px; right:-4px; bottom:-4px; border-radius:50%; border:2px solid #6366f1; animation:pulse-ring 2s infinite; pointer-events:none; }
@keyframes pulse-ring { 0%{transform:scale(1);opacity:0.8} 100%{transform:scale(1.4);opacity:0} }

@media (max-width:600px) {
  .game-container { padding:16px 12px 32px; }
  .intro h1 { font-size:28px; }
  .question-card { padding:20px 16px; }
  .dim-legend { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<canvas id="starfield"></canvas>

<!-- Level Transition Overlay -->
<div class="level-transition" id="levelTransition">
  <div class="lt-icon" id="ltIcon"></div>
  <div class="lt-text" id="ltText"></div>
  <div class="lt-sub" id="ltSub"></div>
</div>

<!-- Exit Confirm -->
<div class="confirm-overlay" id="confirmOverlay">
  <div class="confirm-box">
    <h3>确定要退出吗？</h3>
    <p>所有已完成的回答将会保存。</p>
    <div class="btn-row">
      <button class="btn btn-secondary" onclick="document.getElementById('confirmOverlay').classList.remove('show')">继续游戏</button>
      <button class="btn btn-primary" onclick="showResults()">查看结果</button>
    </div>
  </div>
</div>

<div class="game-container" id="gameContainer">

<!-- ==================== INTRO SCREEN ==================== -->
<div class="screen active" id="screenIntro">
  <div class="intro">
    <div class="intro-logo">✦</div>
    <h1>创 光 计 划</h1>
    <div class="sub">光 之 大 陆 探 险</div>
    <div class="lore">
      <strong>背景：</strong>你是一名被选中的<strong>光之探索者</strong>。光之大陆有5个未知领域等待着被照亮——每盏灯的亮度，取决于你的选择、你的勇气、你的真实。<br><br>
      这不是考试，没有标准答案。<br>
      这是一次自我发现之旅。<br>
      你只需<strong>做自己</strong>——剩下的事，交给光。
    </div>
    <div class="name-input-group">
      <label>选择你的身份</label>
      <select id="playerName" onchange="document.getElementById('customName').style.display=this.value==='custom'?'block':'none'">
        <option value="">-- 请选择 --</option>
        <option value="custom">其他（手动输入）</option>
      </select>
      <input type="text" id="customName" placeholder="输入你的名字" style="display:none;margin-top:8px;" maxlength="20">
    </div>
    <button class="btn btn-primary" onclick="startGame()">
      <span>✦</span> 开始探险
    </button>
  </div>
</div>

<!-- ==================== LEVEL SCREEN ==================== -->
<div class="screen" id="screenLevel">
  <div class="progress-wrap">
    <div class="progress-info">
      <span id="levelLabel">第一关</span>
      <span id="questionCounter">1/5</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
  </div>
  <div class="level-header">
    <div class="level-icon" id="levelIcon"></div>
    <div class="level-name" id="levelName"></div>
    <div class="level-desc" id="levelDesc"></div>
  </div>
  <div id="questionArea"></div>
  <div class="nav-row">
    <button class="btn btn-secondary" id="btnPrev" onclick="prevQuestion()" style="visibility:hidden;">◂ 上一题</button>
    <div class="timer-indicator">
      <span class="timer-dot"></span>
      <span id="timerDisplay">00:00</span>
    </div>
    <button class="btn btn-secondary" id="btnNext" onclick="nextQuestion()" disabled>继续 ▸</button>
  </div>
</div>

<!-- ==================== RESULTS SCREEN ==================== -->
<div class="screen" id="screenResults">
  <div class="results">
    <div class="results-header">
      <div class="badge">✦ 评估完成</div>
      <h2>你的光谱报告</h2>
      <div class="p-name" id="resultName"></div>
      <div class="stats-row">
        <div class="stat-item"><div class="val" id="statTime"></div><div class="label">总耗时</div></div>
        <div class="stat-item"><div class="val" id="statLevel"></div><div class="label">完成关卡</div></div>
        <div class="stat-item"><div class="val" id="statOverall"></div><div class="label">综合指数</div></div>
      </div>
    </div>
    <div class="radar-box"><canvas id="radarCanvas" width="420" height="420"></canvas></div>
    <div class="dim-legend" id="dimLegend"></div>
    <div class="insight-card"><h4>🔍 AI洞察摘要</h4><p id="insightText"></p></div>
    <div class="insight-card"><h4>⚠️ 关注提示</h4><p id="alertText"></p></div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:16px;">
      <button class="btn btn-primary" onclick="restartGame()">重新开始</button>
      <button class="btn btn-secondary" onclick="window.print()">打印报告</button>
    </div>
    <div class="export-hint">本测评基于"创光计划·轻量版方案A"设计 | 所有数据仅用于委培项目人才评估 | HRBP: yanyan07</div>
  </div>
</div>

</div><!-- .game-container -->

<script>
// ==================== GAME STATE ====================
const state = {
  playerName: '',
  currentLevel: 0,
  currentQ: 0,
  totalQ: 21,
  answers: {},
  timings: {},
  startTimes: {},
  gameStart: 0,
  levelStart: 0,
  qStart: 0,
  timerInterval: null,
  elapsed: 0,
};

// ==================== LEVEL DEFINITIONS ====================
const levels = [
  {
    id: 1,
    name: '初心灯塔',
    icon: '🏰',
    desc: '回忆入职以来的旅程，点亮你的灯塔',
    color: '#6366f1',
    dims: ['融入度', '归属感'],
    questions: [
      { id:'Q1', type:'radio', text:'入职这半年来，如果用一个天气来形容你的状态，最接近的是？', options:['持续晴天','多云转晴','时有阵雨','雾霾重重','暴风雨'], scoring:[5,4,3,2,1], dim:'融入度' },
      { id:'Q2', type:'text', text:'入职第一天你收到了"新人百宝箱"。半年后回头看，哪个"工具"对你帮助最大？哪个你希望当时就有但现在还没有？', dim:'归属感' },
      { id:'Q3', type:'radio', text:'你在团队中"第一个求助的人"是谁？如果TA离开了，你会找谁？', options:['直线上级','业务导师','HRBP','同期校招生','其他同事','自己解决'], scoring:[4,5,3,3,2,1], dim:'融入度' },
      { id:'Q4', type:'radio', text:'【情景】周五下午6点，你手头的工作刚做完，导师走过来说"有空帮忙看个紧急数据吗"。你的第一反应？', options:['立刻答应并投入','答应但心里有点烦','询问是否可以周一处理','委婉拒绝'], scoring:[5,3,2,1], dim:'归属感' },
    ]
  },
  {
    id: 2,
    name: '能量脉冲',
    icon: '⚡',
    desc: '管理你的能量网络，展现真实的精力状态',
    color: '#10b981',
    dims: ['健康度', '承压力'],
    questions: [
      { id:'Q5', type:'slider', text:'如果一天的精力总量是100%，你目前的分配大概是？', sliders:[{label:'工作',key:'work'},{label:'学习成长',key:'learn'},{label:'社交',key:'social'},{label:'休息恢复',key:'rest'},{label:'其他',key:'other'}], dim:'健康度' },
      { id:'Q6', type:'radio', text:'【情景】你接手了一个没做过的分析任务，周五要给结果。周三发现数据源有问题，取数逻辑需要重来。你会？', options:['自己加班搞定','立刻找导师求助','先和leader同步风险再想办法','硬撑到周五看情况','其他'], scoring:[3,4,5,1,2], dim:'承压力' },
      { id:'Q7', type:'multi', text:'最近一个月，以下哪种情绪你感受最多？（最多选3个）', options:['成就感','焦虑感','成长感','无聊感','归属感','迷茫感','疲惫感'], maxSelect:3, dim:'健康度' },
      { id:'Q8', type:'radio', text:'如果你的"工作电池"需要充电，你最需要什么？', options:['一个完整周末','导师的一次深度反馈','一个能独立负责的小项目','和同期伙伴聊聊','其他'], scoring:[2,4,5,3,1], dim:'承压力' },
    ]
  },
  {
    id: 3,
    name: '成长森林',
    icon: '🌱',
    desc: '培育你的能力之树，看清成长的方向',
    color: '#38bdf8',
    dims: ['成长力', '成长力'],
    questions: [
      { id:'Q9', type:'text', text:'回顾这半年，哪个瞬间让你觉得"我真的在成长"？（1-2句话）', dim:'成长力' },
      { id:'Q10', type:'radio', text:'【情景】导师去海外出差2周，走前说"这段时间你自己看着办"。你会怎么安排？', options:['按之前安排继续','主动找还没接触过的模块学习','向其他同事寻求任务','放松一点等导师回来','整理之前的产出复盘'], scoring:[3,5,4,1,3], dim:'成长力' },
      { id:'Q11', type:'radio', text:'如果给你一笔"技能点"可以点在任意风控技能上，你会优先点什么？', options:['策略分析','模型开发','数据工程','业务理解','外语/跨文化沟通','项目管理','其他'], scoring:[4,3,3,4,5,3,2], dim:'成长力' },
      { id:'Q12', type:'text', text:'你觉得目前最需要的培养资源是什么？', dim:'成长力' },
    ]
  },
  {
    id: 4,
    name: '星桥连结',
    icon: '🤝',
