    }
  };

  let insight = `综合指数 ${overall}%，最突出维度：<strong>${maxDim[0]}</strong>（${maxDim[1]}%）。` +
    `<br>${insights.high[maxDim[0]] || ''}`;
  let alert = '';
  if (minDim[1] < 40) {
    alert = `⚠️ <strong>${minDim[0]}</strong>维度得分较低（${minDim[1]}%），${insights.low[minDim[0]] || ''}`;
  } else if (minDim[1] < 55) {
    alert = `🟡 <strong>${minDim[0]}</strong>维度值得关注（${minDim[1]}%），${insights.low[minDim[0]] || ''}`;
  } else {
    alert = '✅ 各维度表现均衡，无明显低分预警信号。继续按培养计划推进。';
  }

  document.getElementById('insightText').innerHTML = insight;
  document.getElementById('alertText').innerHTML = alert;
}

// ==================== INIT ====================
initStarfield();

// Auto-save on page leave
window.addEventListener('beforeunload', (e) => {
  if (Object.keys(state.answers).length > 0 && !document.getElementById('screenResults').classList.contains('active')) {
    e.preventDefault(); e.returnValue = '';
  }
});

// Keyboard shortcut: Enter to advance
document.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && document.getElementById('screenLevel').classList.contains('active')) {
    const btn = document.getElementById('btnNext');
    if (!btn.disabled) nextQuestion();
  }
});
</script>

