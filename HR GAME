// ==================== SCORING ENGINE ====================
function computeScores() {
  const dims = ['融入度','归属感','健康度','承压力','成长力','跨文化潜能'];
  const scores = {}; dims.forEach(d => { scores[d] = { raw:0, count:0 }; });

  levels.forEach(level => {
    level.questions.forEach(q => {
      const ans = state.answers[q.id];
      if (!ans) return;
      const dim = q.dim;
      if (q.type === 'radio' && q.scoring && ans.value !== undefined) {
        scores[dim].raw += q.scoring[ans.value];
        scores[dim].count++;
      }
      if (q.type === 'radio' && !q.scoring && ans.value !== undefined) {
        // generic: option 0 = best
        const max = q.options.length - 1;
        scores[dim].raw += (max - ans.value) + 1;
        scores[dim].count++;
      }
      if (q.type === 'multi') {
        // More emotions selected = potentially lower score if negative emotions
        const negEmotions = ['焦虑感','无聊感','迷茫感','疲惫感'];
        const posEmotions = ['成就感','成长感','归属感'];
        const val = ans.value || [];
        let positives = 0, negatives = 0;
        val.forEach(i => {
          if (posEmotions.includes(q.options[i])) positives++;
          if (negEmotions.includes(q.options[i])) negatives++;
        });
        const score = Math.max(1, Math.min(5, 3 + positives - negatives));
        scores[dim].raw += score;
        scores[dim].count++;
      }
      if (q.type === 'slider') {
        // Work-life balance: work>60% = lower health score
        const val = ans.value || {};
        const workRatio = (val.work||0) / 100;
        const restRatio = (val.rest||0) / 100;
        const score = Math.max(1, Math.min(5, Math.round(3 + (restRatio*4) - (workRatio>0.5 ? 2 : 0))));
        scores[dim].raw += score;
        scores[dim].count++;
      }
      if (q.type === 'text') {
        // Text length as engagement proxy, plus check for key positive words
        const txt = (ans.value||'').toLowerCase();
        const len = txt.length;
        let score = 2;
        if (len > 20) score = 3;
        if (len > 60) score = 4;
        if (len > 120) score = 5;
        const posWords = ['成长','学到了','进步','挑战','期待','愿意','希望','开心','充实','感谢','帮助','团队','导师','好','good'];
        const negWords = ['累','压力','迷茫','焦虑','不想','不确定','犹豫','担心','难','烦'];
        let p=0,n=0; posWords.forEach(w=>{if(txt.includes(w))p++}); negWords.forEach(w=>{if(txt.includes(w))n++});
        if (p>n) score = Math.min(5, score+1);
        if (n>p) score = Math.max(1, score-1);
        scores[dim].raw += score;
        scores[dim].count++;
      }
    });
  });

  const normalized = {};
  dims.forEach(d => {
    normalized[d] = scores[d].count > 0 ? Math.round((scores[d].raw / scores[d].count) * 20) : 50;
    // Clamp 0-100
    normalized[d] = Math.max(10, Math.min(100, normalized[d]));
  });
  return normalized;
}

// ==================== SHOW RESULTS ====================
function showResults() {
  clearInterval(state.timerInterval);

  document.getElementById('screenLevel').classList.remove('active');
  document.getElementById('screenIntro').classList.remove('active');
  document.getElementById('screenResults').classList.add('active');
  document.getElementById('resultName').textContent = `探索者：${state.playerName}`;

  const totalElapsed = Math.floor((Date.now() - state.gameStart) / 1000);
  const min = Math.floor(totalElapsed/60), sec = totalElapsed%60;
  document.getElementById('statTime').textContent = `${min}分${sec}秒`;
  document.getElementById('statLevel').textContent = `${levels.length}关`;

  const scores = computeScores();
  const overall = Math.round(Object.values(scores).reduce((a,b)=>a+b,0)/6);
  document.getElementById('statOverall').textContent = overall + '%';

  // Radar chart
  drawRadar(scores);
  // Dimension legend
  renderDimLegend(scores);
  // Insights
  generateInsights(scores);

  window.scrollTo({top:0,behavior:'smooth'});
}

function drawRadar(scores) {
  const canvas = document.getElementById('radarCanvas');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const cx = W/2, cy = H/2, r = 150;
  const dims = ['融入度','归属感','健康度','承压力','成长力','跨文化潜能'];
  const labels = ['融入度','归属感','健康度','承压力','成长力','跨文化'];
  const n = dims.length;

  ctx.clearRect(0,0,W,H);

  // Grid
  for (let g = 1; g <= 5; g++) {
    ctx.beginPath();
    for (let i = 0; i < n; i++) {
      const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
      const rr = (r / 5) * g;
      const x = cx + rr * Math.cos(angle), y = cy + rr * Math.sin(angle);
      if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    ctx.closePath();
    ctx.strokeStyle = g===5 ? '#334155' : '#1e293b';
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  // Axes
  for (let i = 0; i < n; i++) {
    const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
    ctx.beginPath(); ctx.moveTo(cx,cy); ctx.lineTo(cx+r*Math.cos(angle),cy+r*Math.sin(angle));
    ctx.strokeStyle = '#1e293b'; ctx.stroke();
    // Labels
    const lx = cx + (r+30) * Math.cos(angle), ly = cy + (r+30) * Math.sin(angle);
    ctx.fillStyle = '#94a3b8'; ctx.font = '13px "PingFang SC","Microsoft YaHei",sans-serif';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(labels[i], lx, ly);
  }

  // Data polygon
  ctx.beginPath();
  for (let i = 0; i < n; i++) {
    const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
    const val = scores[dims[i]] / 100;
    const rr = val * r;
    const x = cx + rr * Math.cos(angle), y = cy + rr * Math.sin(angle);
    if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  }
  ctx.closePath();
  ctx.fillStyle = 'rgba(99,102,241,0.2)';
  ctx.fill();
  ctx.strokeStyle = '#818cf8'; ctx.lineWidth = 2.5;
  ctx.stroke();

  // Points
  for (let i = 0; i < n; i++) {
    const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
    const val = scores[dims[i]] / 100;
    const rr = val * r;
    const x = cx + rr * Math.cos(angle), y = cy + rr * Math.sin(angle);
    ctx.beginPath(); ctx.arc(x,y,5,0,Math.PI*2);
    ctx.fillStyle = '#818cf8'; ctx.fill();
    ctx.fillStyle = '#e2e8f0'; ctx.font = 'bold 11px "PingFang SC","Microsoft YaHei",sans-serif';
    ctx.textAlign = 'center'; ctx.fillText(scores[dims[i]], x, y-14);
  }
}

