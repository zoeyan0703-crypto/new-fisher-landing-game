// ==================== STARFIELD ====================
function initStarfield() {
  const c = document.getElementById('starfield'), ctx = c.getContext('2d');
  let stars = [];
  function resize() { c.width = window.innerWidth; c.height = window.innerHeight; }
  resize(); window.addEventListener('resize', resize);
  for (let i = 0; i < 200; i++) {
    stars.push({ x:Math.random()*c.width, y:Math.random()*c.height, r:Math.random()*1.5+0.3, a:Math.random(), s:Math.random()*0.008+0.003 });
  }
  function draw() {
    ctx.clearRect(0,0,c.width,c.height);
    stars.forEach(s => {
      s.a += s.s; if(s.a>1||s.a<0.2) s.s*=-1;
      ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle = `rgba(148,163,184,${s.a})`; ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  draw();
}

// ==================== TIMER ====================
function startTimer() {
  state.qStart = Date.now();
  clearInterval(state.timerInterval);
  state.timerInterval = setInterval(() => {
    const elapsed = Math.floor((Date.now() - state.qStart)/1000);
    document.getElementById('timerDisplay').textContent = `${String(Math.floor(elapsed/60)).padStart(2,'0')}:${String(elapsed%60).padStart(2,'0')}`;
  }, 200);
}

function stopTimer(qid) {
  clearInterval(state.timerInterval);
  const elapsed = Math.floor((Date.now() - state.qStart)/1000);
  // Only record timing on first attempt (when going back, preserve original)
  if (!state.timings[qid]) state.timings[qid] = elapsed;
  if (!state.startTimes[qid]) state.startTimes[qid] = new Date(state.qStart).toISOString();
}

// ==================== RENDER QUESTION ====================
function renderQuestion() {
  const level = levels[state.currentLevel];
  const q = level.questions[state.currentQ];
  const area = document.getElementById('questionArea');
  area.innerHTML = '';

  const card = document.createElement('div');
  card.className = 'question-card';

  card.innerHTML = `
    <div class="q-num">关卡${level.id} · 第${state.currentQ+1}题 / ${level.questions.length}题</div>
    <div class="q-text">${q.text}</div>
  `;

  const content = document.createElement('div');

  if (q.type === 'radio') {
    const list = document.createElement('div'); list.className = 'option-list';
    q.options.forEach((opt, i) => {
      const div = document.createElement('div'); div.className = 'option';
      div.innerHTML = `<span class="radio"></span><span class="opt-text">${opt}</span>`;
      div.addEventListener('click', () => {
        list.querySelectorAll('.option').forEach(o => o.classList.remove('selected'));
        div.classList.add('selected');
        state.answers[q.id] = { type:'radio', value:i, label:opt };
        checkReady();
      });
      if (state.answers[q.id] && state.answers[q.id].value === i) div.classList.add('selected');
      list.appendChild(div);
    });
    content.appendChild(list);
  }

  else if (q.type === 'multi') {
    const list = document.createElement('div'); list.className = 'option-list';
    const selected = state.answers[q.id] ? state.answers[q.id].value : [];
    q.options.forEach((opt, i) => {
      const div = document.createElement('div'); div.className = 'option multi';
      div.innerHTML = `<span class="radio"></span><span class="opt-text">${opt}</span>`;
      if (selected.includes(i)) div.classList.add('selected');
      div.addEventListener('click', () => {
        if (div.classList.contains('selected')) {
          div.classList.remove('selected');
          const idx = selected.indexOf(i); if(idx>=0) selected.splice(idx,1);
        } else {
          if (selected.length >= q.maxSelect) {
            const first = selected.shift();
            list.children[first].classList.remove('selected');
          }
          div.classList.add('selected'); selected.push(i);
        }
        state.answers[q.id] = { type:'multi', value:[...selected], label:q.options.filter((_,j)=>selected.includes(j)).join('、') };
        checkReady();
      });
      list.appendChild(div);
    });
    content.appendChild(list);
  }

  else if (q.type === 'slider') {
    const group = document.createElement('div'); group.className = 'slider-group';
    const vals = state.answers[q.id] ? state.answers[q.id].value : {};
    q.sliders.forEach(s => {
      const row = document.createElement('div'); row.className = 'slider-row';
      const val = vals[s.key] !== undefined ? vals[s.key] : 20;
      row.innerHTML = `<span style="font-size:13px;color:#94a3b8;min-width:70px;">${s.label}</span>
        <input type="range" min="0" max="100" value="${val}" data-key="${s.key}">
        <span class="slider-val">${val}%</span>`;
      const input = row.querySelector('input');
      const display = row.querySelector('.slider-val');
      input.addEventListener('input', () => { display.textContent = input.value + '%'; updateSliders(); });
      group.appendChild(row);
    });
    content.appendChild(group);
    const updateSliders = () => {
      const obj = {};
      group.querySelectorAll('input').forEach(inp => obj[inp.dataset.key] = parseInt(inp.value));
      state.answers[q.id] = { type:'slider', value:obj, label:Object.entries(obj).map(([k,v])=>`${k}:${v}%`).join(', ') };
      checkReady();
    };
  }

  else if (q.type === 'text') {
    const ta = document.createElement('textarea');
    ta.className = 'text-input'; ta.placeholder = '请输入你的真实想法...';
    ta.value = state.answers[q.id] ? state.answers[q.id].value : '';
    const chars = document.createElement('div'); chars.className = 'chars-left'; chars.textContent = '0 / 500 字';
    ta.addEventListener('input', () => {
      chars.textContent = ta.value.length + ' / 500 字';
      state.answers[q.id] = { type:'text', value:ta.value, label:ta.value.substring(0,50) + (ta.value.length>50?'...':'') };
      checkReady();
    });
    content.appendChild(ta);
    content.appendChild(chars);
  }

  card.appendChild(content);
  area.appendChild(card);

  // Update nav
  document.getElementById('questionCounter').textContent = `Q${(state.currentQ + 1 + levels.slice(0,state.currentLevel).reduce((s,l)=>s+l.questions.length,0))}/${state.totalQ}`;
  document.getElementById('levelLabel').textContent = `第${level.id}关 · ${level.name}`;
  document.getElementById('levelIcon').textContent = level.icon;
  document.getElementById('levelName').textContent = level.name;
  document.getElementById('levelDesc').textContent = level.desc;
  const totalProgress = ((state.currentQ + 1 + levels.slice(0,state.currentLevel).reduce((s,l)=>s+l.questions.length,0)) / state.totalQ) * 100;
  document.getElementById('progressFill').style.width = totalProgress + '%';
  document.getElementById('btnNext').disabled = !state.answers[q.id];
  // Show/hide prev button
  const isFirstQ = (state.currentLevel === 0 && state.currentQ === 0);
  document.getElementById('btnPrev').style.visibility = isFirstQ ? 'hidden' : 'visible';

  // For slider questions, add total validation
  if (q.type === 'slider') {
    const totalDisplay = document.createElement('div');
    totalDisplay.id = 'sliderTotal';
    totalDisplay.style.cssText = 'text-align:center;margin-top:10px;font-size:14px;font-weight:700;color:#38bdf8;';
    area.querySelector('.question-card').appendChild(totalDisplay);
    const updateSliderTotal = () => {
      const ans = state.answers[q.id];
      const total = ans ? Object.values(ans.value).reduce((a,b)=>a+b,0) : 0;
      totalDisplay.textContent = `当前总计：${total}%` + (total === 100 ? ' ✅' : `（${total>100?'超出':'还差'}${Math.abs(100-total)}%）`);
      totalDisplay.style.color = total === 100 ? '#34d399' : total > 100 ? '#f43f5e' : '#f59e0b';
      // Validate: slider requires total === 100
      if (ans && total !== 100) {
        document.getElementById('btnNext').disabled = true;
        if (!document.getElementById('sliderWarning')) {
          const warn = document.createElement('div');
          warn.id = 'sliderWarning';
          warn.style.cssText = 'text-align:center;font-size:12px;color:#f43f5e;margin-top:4px;';
          warn.textContent = '⚠ 五项合计必须为100%才能继续';
          area.querySelector('.question-card').appendChild(warn);
        }
      } else if (ans && total === 100) {
        document.getElementById('btnNext').disabled = false;
        const warn = document.getElementById('sliderWarning');
        if (warn) warn.remove();
      }
    };
    // Hook into existing slider inputs
    area.querySelectorAll('input[type=range]').forEach(inp => {
      inp.addEventListener('input', updateSliderTotal);
    });
    updateSliderTotal();
  }

  // Scroll into view
  card.scrollIntoView({behavior:'smooth',block:'center'});
  startTimer();
}

function checkReady() {
  const level = levels[state.currentLevel];
  const q = level.questions[state.currentQ];
  if (!state.answers[q.id]) return;
  // For slider questions, also validate total === 100
  if (q.type === 'slider') {
    const total = Object.values(state.answers[q.id].value).reduce((a,b)=>a+b,0);
    if (total !== 100) return;
  }
  document.getElementById('btnNext').disabled = false;
}

// ==================== NAVIGATION ====================
function nextQuestion() {
  const level = levels[state.currentLevel];
  const q = level.questions[state.currentQ];
  stopTimer(q.id);

  state.currentQ++;
  if (state.currentQ >= level.questions.length) {
    if (state.currentLevel < levels.length - 1) {
      showTransition(() => {
        state.currentLevel++;
        state.currentQ = 0;
        state.levelStart = Date.now();
        renderQuestion();
      });
    } else {
      showResults();
    }
  } else {
    renderQuestion();
  }
}

function prevQuestion() {
  const level = levels[state.currentLevel];
  const q = level.questions[state.currentQ];
  stopTimer(q.id);

  state.currentQ--;
  if (state.currentQ < 0) {
    // Go back to previous level's last question
    state.currentLevel--;
    state.currentQ = levels[state.currentLevel].questions.length - 1;
  }
  renderQuestion();
}

function showTransition(cb) {
  const nextLevel = levels[state.currentLevel + 1];
  const overlay = document.getElementById('levelTransition');
  document.getElementById('ltIcon').textContent = nextLevel.icon;
  document.getElementById('ltText').textContent = `即将进入：${nextLevel.name}`;
  document.getElementById('ltSub').textContent = nextLevel.desc;
  overlay.classList.add('show');
  setTimeout(() => { overlay.classList.remove('show'); cb(); }, 1800);
}

