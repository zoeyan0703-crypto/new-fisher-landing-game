<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cadre Pro · 高保真原型</title><style>html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#faf9fd}#screen{width:100%;height:100%;border:0;display:block;background:#faf9fd}#toast{position:fixed;right:24px;bottom:24px;z-index:999999;background:#002045;color:#fff;border-radius:8px;padding:12px 16px;font:600 13px Inter,-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;box-shadow:0 12px 32px rgba(0,32,69,.25);opacity:0;transform:translateY(8px);pointer-events:none;transition:.2s}#toast.show{opacity:1;transform:translateY(0)}</style></head><body><iframe id="screen" title="Cadre Pro 高保真原型"></iframe><div id="toast" aria-live="polite"></div><script>
const sourcePages = {"dashboard": "", "employees": "", "profile": "", "assessment-record": "", "overseas": "", "assessment-form": "", "matrix": "", "report-config": "", "report-preview": "", "permissions": ""};
const names = new Set(Object.keys(sourcePages));
const frame = document.getElementById('screen');
const toast = document.getElementById('toast');
let toastTimer;
function decode(value){const binary=atob(value);const data=new Uint8Array(binary.length);for(let i=0;i<binary.length;i++)data[i]=binary.charCodeAt(i);return new TextDecoder('utf-8').decode(data)}
function pageFromHash(){const name=location.hash.slice(1);return names.has(name)?name:'dashboard'}
function render(name,push){const target=names.has(name)?name:'dashboard';if(push&&location.hash!=='#'+target)location.hash=target;frame.srcdoc=decode(sourcePages[target])}
function notice(message){toast.textContent=message;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),1800)}
window.addEventListener('message',(event)=>{const data=event.data||{};if(data.channel!=='cadre-pro')return;if(data.type==='navigate')render(data.route,true);if(data.type==='action')notice(data.message||'操作已响应')});
window.addEventListener('hashchange',()=>render(pageFromHash(),false));render(pageFromHash(),false);
</script></body></html>
